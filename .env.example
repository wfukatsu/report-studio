# Java backend port (default: 8080)
# Copy to .env and adjust as needed
VITE_API_PORT=8080

# --- Keycloak (OIDC) login, optional (#499). Backend env vars, see docs/setup.md ---
# OIDC_ISSUER=http://localhost:8180/realms/report-studio
# OIDC_CLIENT_ID=report-studio
# OIDC_REDIRECT_URI=http://localhost:5173/api/v1/auth/oidc/callback
# AUTH_MODE=both   # local | oidc | both (default: local, or both when OIDC_ISSUER is set)
