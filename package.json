{
  "name": "report-studio",
  "private": true,
  "version": "1.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd server && ./gradlew run",
    "seed": "cd server && ./gradlew seed",
    "dev:full": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "typecheck:native": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build:backend": "cd server && ./gradlew shadowJar",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:backend": "cd server && ./gradlew test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate:schema": "vite-node scripts/generate-json-schema.ts",
    "i18n:extract": "i18next --config i18next-parser.config.js",
    "i18n:extract:check": "i18next --config i18next-parser.config.js --fail-on-update",
    "build:samples": "node scripts/sample-forms/build.mjs",
    "seed:samples": "node scripts/sample-forms/seed.mjs",
    "cli": "node scripts/cli/report-studio.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.11",
    "@pawel-up/jexl": "^4.4.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.21",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.57.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.18",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lezer/generator": "^1.8.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "i18next-parser": "^9.4.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "unplugin-lezer": "^1.0.1",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
